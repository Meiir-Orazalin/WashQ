{
  "name": "@washqueue/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude test/**/*.integration.test.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e:cleanup": "node --env-file-if-exists=../../.env test-support/auth-e2e-database.mjs cleanup-prefix",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "@washqueue/contracts": "workspace:*",
    "argon2": "0.44.0",
    "cookie": "2.0.1",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jose": "6.2.3",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.28",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.1",
    "@washqueue/eslint-config": "workspace:*",
    "@washqueue/typescript-config": "workspace:*",
    "dotenv": "17.4.2",
    "eslint": "10.7.0",
    "prisma": "7.9.0",
    "supertest": "7.2.2",
    "tsx": "4.23.1",
    "vitest": "4.1.10"
  }
}
