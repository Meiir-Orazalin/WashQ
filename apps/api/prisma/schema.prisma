generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  firstName    String   @map("first_name") @db.VarChar(60)
  lastName     String?  @map("last_name") @db.VarChar(60)
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshSessions         RefreshSession[]
  vehicles                Vehicle[]
  organizationMemberships OrganizationMembership[]

  @@map("users")
}

enum OrganizationMembershipRole {
  OWNER

  @@map("organization_membership_role")
}

model Organization {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String                   @db.VarChar(120)
  description String?                  @db.VarChar(500)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships OrganizationMembership[]
  branches    Branch[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                     @map("organization_id") @db.Uuid
  userId         String                     @map("user_id") @db.Uuid
  role           OrganizationMembershipRole
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId])
  @@index([userId, role])
  @@map("organization_memberships")
}

enum BranchWeekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY

  @@map("branch_weekday")
}

enum BranchOpeningStatus {
  CLOSED
  OPEN
  OPEN_24_HOURS

  @@map("branch_opening_status")
}

model Branch {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  name           String               @db.VarChar(100)
  city           String               @db.VarChar(100)
  addressLine    String               @map("address_line") @db.VarChar(250)
  timeZone       String               @map("time_zone") @db.VarChar(100)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  openingHours   BranchOpeningHours[]

  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("branches")
}

model BranchOpeningHours {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branchId       String              @map("branch_id") @db.Uuid
  dayOfWeek      BranchWeekday       @map("day_of_week")
  status         BranchOpeningStatus
  opensAtMinute  Int?                @map("opens_at_minute")
  closesAtMinute Int?                @map("closes_at_minute")
  closesNextDay  Boolean             @default(false) @map("closes_next_day")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  branch         Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
  @@map("branch_opening_hours")
}

model Vehicle {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId    String   @map("owner_user_id") @db.Uuid
  make           String   @db.VarChar(60)
  model          String   @db.VarChar(60)
  plateNumber    String   @map("plate_number") @db.VarChar(20)
  productionYear Int?     @map("production_year")
  color          String?  @db.VarChar(40)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner          User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, plateNumber])
  @@index([ownerUserId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("vehicles")
}

model RefreshSession {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  familyId            String    @default(dbgenerated("gen_random_uuid()")) @map("family_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedBySessionId String?   @unique @map("replaced_by_session_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  replacement RefreshSession? @relation("RefreshSessionReplacement", fields: [replacedBySessionId], references: [id], onDelete: SetNull)
  replaces    RefreshSession? @relation("RefreshSessionReplacement")

  @@index([familyId, revokedAt])
  @@index([userId])
  @@map("refresh_sessions")
}
